# Luuna Mark / AI Influencer Studio — dev server
# Kopeeri:  copy .env.example .env.local
# Täida oma võtmed. .env.local ära commiti giti.
#
# Chat vaikimisi: Ollama või LM Studio (tasuta, kohalik)
# Pilve-providerid: lisa võti siia + chatis „Kasuta dev serveri env võtit“ ON
# Taaskäivita pärast muudatusi: npm run dev

# ── Tasuta kohalik chat (builder + käsud) ─────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Kohalik või Ollama pilvemudel (nt minimax-m3:cloud, kimi-k2.5:cloud)
OLLAMA_MODEL=minimax-m3:cloud
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=local-model
# LMSTUDIO_API_KEY=lm-studio-api-token
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_MODEL=hermes-agent
# HERMES_API_KEY=change-me-local-dev
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_MODEL=openclaw/default
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# ── Pilv (valikuline, API võti) ───────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GROK_API_KEY=xai-XXXXXXXX
# XAI_API_KEY=xai-XXXXXXXX
# PERPLEXITY_API_KEY=pplx-XXXXXXXX
# DEEPSEEK_API_KEY=sk-XXXXXXXX
# ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
# CLAUDE_API_KEY=sk-ant-XXXXXXXX
# HUGGINGFACE_API_KEY=hf-XXXXXXXX
# HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct